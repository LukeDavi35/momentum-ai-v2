    "weekly": { "enabled": true, "cron": "0 9 * * 0",   "label": "This week's biggest sports moments", "lookbackHours": 168, "maxStories": 6, "footage": { "enabled": true, "providers": ["library", "pexels", "commons"], "minClipSeconds": 3, "licenses": ["cc0", "public_domain", "cc_by", "pexels", "owned"], "reuseCooldownDays": 7 } }

{
  "name": "momentum-ai-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start:api": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev:api": "tsx src/main.ts",
    "dev:worker": "tsx src/worker.ts",
    "dryrun": "tsx scripts/dryrun.ts",
    "oauth": "tsx scripts/oauth.ts",
    "rollback": "tsx scripts/rollback-weights.ts",
    "test:redis": "vitest run test/queue"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@electric-sql/pglite": "^0.5.8",
    "bullmq": "^6.3.12",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.2",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}

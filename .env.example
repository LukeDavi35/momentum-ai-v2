# Copy to .env and fill in. Never commit .env.

# --- Core ---
NODE_ENV=production
LOG_LEVEL=info
# true = run the whole loop but never call a publishing API (writes payloads to out/dryrun/)
DRY_RUN=true
# Dry-run only: publish ~immediately and compress analytics checkpoints to seconds (demos)
DRY_RUN_FAST=false
DRY_RUN_FAST_STEP_S=5
# true = pause ALL publishing immediately (can also be toggled from the dashboard)
KILL_SWITCH=false
# Hard cap on posts in any rolling 24h, regardless of config/schedule.json
MAX_POSTS_PER_DAY=9
CONFIG_DIR=./config
DATA_DIR=./data
MEDIA_DIR=./out/media
REPORT_DIR=./reports

# --- Infra ---
# Leave DATABASE_URL empty to use embedded PGlite in DATA_DIR (dev/dry-run only)
DATABASE_URL=postgres://momentum:momentum@postgres:5432/momentum
REDIS_URL=redis://redis:6379

# --- Dashboard / API ---
API_PORT=8080
# Bearer token for every /api call (generate: openssl rand -hex 32)
ADMIN_TOKEN=
# Public HTTPS base URL of this app (Instagram must fetch videos from here; OAuth callbacks too)
PUBLIC_BASE_URL=https://momentum.example.com
# 32-byte hex key used to encrypt OAuth tokens at rest (generate: openssl rand -hex 32)
TOKEN_ENC_KEY=
# Secret for signing media URLs (generate: openssl rand -hex 32)
MEDIA_SIGNING_SECRET=

# --- LLM (leave ANTHROPIC_API_KEY empty to use the labelled stub LLM in dry-run) ---
ANTHROPIC_API_KEY=
LLM_MODEL_WRITER=claude-sonnet-5
LLM_MODEL_REVIEWER=claude-sonnet-5
LLM_MODEL_FAST=claude-haiku-4-5-20251001

# --- Voice ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Fallback TTS + optional embeddings
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
# dev-only TTS used when neither key is set (needs espeak-ng installed; the Docker image has it)
ALLOW_DEV_TTS=true

# --- Rendering ---
# ffmpeg = FFmpeg-only typographic renderer (always available); remotion = Remotion compositions
RENDERER=ffmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# Chromium for Remotion (the Docker image installs it)
CHROMIUM_PATH=/usr/bin/chromium

# --- Sources ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Social platforms (see SETUP_CHECKLIST.md) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Alerting (any/all; leave blank to disable a channel) ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GENERIC_WEBHOOK_URL=
SMTP_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
